# Server Configuration
PORT=8080
BASE_URL=http://localhost:8080
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=10

# Redis (Kept strictly as a URL)
REDIS_URL="rediss://default:<password>@<host>:6379"
CACHE_TTL_HOURS=24

# PostgreSQL (Kept strictly as a URL, direct connection, no pooler)
DATABASE_URL="postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require"

# Tigris S3 Data Lake (Parts making up the S3 URL & credentials)
AWS_ACCESS_KEY_ID=tid_your_access_key
AWS_SECRET_ACCESS_KEY=tsec_your_secret_key
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
TIGRIS_BUCKET=shortener-analytics

# Analytics Pipeline & In-Memory Batching
BATCH_SIZE=1000
BATCH_INTERVAL_SECONDS=5
CHANNEL_CAPACITY=10000
WORKER_POOL_SIZE=4
SALT_SECRET=change-this-to-a-secure-salt-for-privacy-ip-hashing
